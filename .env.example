# ======================================
# LOKA STAY BACKEND — Environment Setup
# ======================================
# Salin file ini: cp .env.example .env
# Isi nilai sesuai setup kamu

# PostgreSQL Database URL
# Format Railway: postgresql://postgres:PASSWORD@HOST:PORT/railway
# Format Supabase: postgresql://postgres:PASSWORD@db.XXX.supabase.co:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT Secret — WAJIB diganti! Gunakan string random panjang
JWT_SECRET="lokastay-ganti-ini-dengan-string-random-yang-panjang-dan-aman"

# Port server (Railway/Render set otomatis)
PORT=3000
